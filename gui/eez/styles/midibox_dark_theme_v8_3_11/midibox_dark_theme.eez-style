{
  "version": "1.0",
  "type": "eez-style-collection",
  "name": "Midibox Dark Neon Theme (LVGL 8.3.11)",
  "styles": [
    {
      "name": "style_panel",
      "type": "color-style",
      "bg_color": "#1C1F24",
      "border_color": "#33373D",
      "text_color": "#E0E0E0",
      "shadow_width": 0,
      "notes": "Main screen background"
    },
    {
      "name": "style_container",
      "type": "color-style",
      "bg_color": "#2A2E35",
      "border_color": "#33373D",
      "text_color": "#E0E0E0",
      "shadow_width": 0,
      "notes": "Sub-panels, grouped areas"
    },
    {
      "name": "style_btn_primary",
      "type": "color-style",
      "bg_color": "#00F0FF",
      "border_color": "#00C0E0",
      "text_color": "#1C1F24",
      "shadow_width": 8,
      "shadow_color": "#00C0E0",
      "notes": "Primary neon cyan button"
    },
    {
      "name": "style_btn_accent",
      "type": "color-style",
      "bg_color": "#FF9900",
      "border_color": "#FFB84D",
      "text_color": "#1C1F24",
      "shadow_width": 6,
      "shadow_color": "#FF9900",
      "notes": "Amber accent button (modulation, warning)"
    },
    {
      "name": "style_label_text",
      "type": "color-style",
      "text_color": "#E0E0E0",
      "bg_color": "#1C1F24",
      "notes": "Default text label"
    },
    {
      "name": "style_label_secondary",
      "type": "color-style",
      "text_color": "#A0A0A0",
      "bg_color": "#1C1F24",
      "notes": "Subdued text label or value"
    },
    {
      "name": "style_warning",
      "type": "color-style",
      "bg_color": "#FF4C4C",
      "border_color": "#FF0000",
      "text_color": "#FFFFFF",
      "shadow_width": 4,
      "shadow_color": "#FF4C4C",
      "notes": "Error or alert indicator"
    }
  ]
}