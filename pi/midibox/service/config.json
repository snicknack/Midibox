  "supercore": {
    "index": 4,
    "modes": ["tempo", "depth"],
    "tempo": {"min": 20, "max": 200, "start": 120, "bpm_per_edge": 1},
    "depth": {"min": 0, "max": 100, "start": 33, "per_edge": 1},
    "send_hz": 20
