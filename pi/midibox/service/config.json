  "haptics": {"enabled": true, "addr": 90, "motor": "erm", "tick_interval_s": 0.012},
  "wheels": {
    "enabled": true,
    "addr": 72,
    "cal_path": "config/ads1115_cal.json",
    "alpha": 0.7,
    "rate_hz": 60,
    "pitch_bar": "uic_pitchBar",
    "mod_bar": "uic_ModBar"
  },
  "faders": {
    "enabled": true,
    "ports": ["/dev/ttyAMA2", "/dev/ttyAMA3"],
    "cal_path": "config/calibration.json",
    "rate_hz": 250,
    "targets": [{"cc": 7}, {"cc": 74}]
  },
  "esp": {"enabled": true, "port": "/dev/serial0", "baud": 115200},
  "midi": {"enabled": true, "port_name": "Midibox Controls", "channel": 1}
