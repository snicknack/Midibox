    "long_press_s": 0.7,
    "step_per_edge": 1,
    "arc_names": ["uic_t1Arc1", "uic_t1Arc2", "uic_t1Arc3", "uic_t1Arc4"],
    "tempo_arc_name": "uic_t1Arc5Tempo"
