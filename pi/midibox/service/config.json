      "pin": 13, "count": 12, "brightness": 12, "strip_type": "SK6812_STRIP_RGBW",
      "top_offset": 7,
      "mode_colors": {"tempo": [0, 255, 255, 0], "depth": [255, 140, 0, 0]},
      "bank_flash": [0, 0, 0, 160]
